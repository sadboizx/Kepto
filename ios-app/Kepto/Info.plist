<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Custom URL scheme, used by the Share Extension to hand a link to
	     the main app: kepto://save?url=<percent-encoded link>.
	     Xcode merges this file's keys into the generated Info.plist
	     (GENERATE_INFOPLIST_FILE stays YES), so only the scheme lives here. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.sadboizx.kepto</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kepto</string>
			</array>
		</dict>
	</array>
	<!-- File sharing (Cách 3, tạm thời): để Documents/debug.log hiện
	     trong Files app (On My iPhone → Kepto) — xem log [Days] /
	     [RowSelect] khi không có Mac/PC. Xoá cùng với FileLog sau
	     khi chẩn đoán xong. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
